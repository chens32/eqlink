<Window x:Class="EqLink.ClientGui.EgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EqLink · 出口设置"
        Width="620" SizeToContent="Height" MinWidth="540" ResizeMode="NoResize"
        Background="#F6F8FB" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="指定出口网卡" FontSize="22" FontWeight="SemiBold" Foreground="#15233B"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#586579"
                       Text="为 EqLink 的 UDP、TCP 外层及域名解析选择同一出口。需要直连时，请选择实际联网的有线或 Wi-Fi 网卡。"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="InterfaceBox" DisplayMemberPath="Label" MinHeight="32"
                      AutomationProperties.Name="出口网卡" SelectionChanged="InterfaceBox_SelectionChanged"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新网卡" Margin="10,0,0,0" Padding="12,6" Click="Refresh_Click"/>
        </Grid>
        <TextBlock x:Name="InterfaceDetails" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#586579"/>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="专用 IPv4 DNS" FontWeight="SemiBold"/>
            <TextBox x:Name="DnsBox" Margin="0,8,0,0" Padding="8,6" AutomationProperties.Name="专用 IPv4 DNS"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#586579"
                       Text="指定网卡时必填，最多 4 个地址，以逗号分隔。选择“系统路由”时，使用系统的路由和 DNS。"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#586579"
                       Text="保存需要管理员权限，并在下次连接时生效。指定网卡不可用时连接失败，不自动改走其他出口。"/>
            <TextBlock x:Name="ResultText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#A33027"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="保存设置" Padding="16,7" Click="Save_Click" IsDefault="True" IsEnabled="False"/>
            <Button Content="关闭" Margin="10,0,0,0" Padding="16,7" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
