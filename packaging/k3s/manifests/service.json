{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": { "name": "eqlink-outer", "namespace": "eqlink-test", "labels": { "app.kubernetes.io/managed-by": "eqlink-test-packer" } },
  "spec": {
    "type": "NodePort", "externalTrafficPolicy": "Local",
    "selector": { "app": "eqlink-server" },
    "ports": [
      { "name": "reality", "protocol": "TCP", "port": 30443, "targetPort": 30443, "nodePort": 30443 },
      { "name": "hysteria", "protocol": "UDP", "port": 30444, "targetPort": 30444, "nodePort": 30444 }
    ]
  }
}
