# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.xaml text eol=lf
*.wxs text eol=lf
*.txt text eol=lf
